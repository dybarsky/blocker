# Copy to keystore.properties (gitignored) and fill in your real values.
# If keystore.properties is absent, `assembleRelease`/`bundleRelease` produce UNSIGNED artifacts.
# Never commit keystore.properties or the keystore itself.

# Path to the keystore; absolute, or relative to the repo root.
storeFile=/absolute/path/to/release.jks
storePassword=changeme
keyAlias=changeme
keyPassword=changeme
