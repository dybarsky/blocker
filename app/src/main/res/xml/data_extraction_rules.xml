<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ rules. The blocked-call log contains phone numbers of callers and is kept
     on the device only (neither cloud backup nor device transfer). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/calls.json"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/calls.json"/>
    </device-transfer>
</data-extraction-rules>
